# Copy to .env and replace placeholders. Never commit .env.
SERVER_URL=https://your-server.example
ESP32_URL=http://your-gate-controller.local
DEVICE_API_KEY=replace-with-a-long-random-device-key

# Local PostgreSQL; replace the password with your local role password.
DATABASE_URL=postgresql+psycopg://smart_gate_user:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/smart_gate

# Required by the backend when creating default staff/admin accounts.
DEFAULT_STAFF_PASSWORD=replace-with-a-unique-random-password
DEFAULT_ADMIN_PASSWORD=replace-with-a-different-unique-random-password

# Optional delivery providers.
TERMII_API_KEY=
TERMII_SENDER_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Smart Gate <no-reply@example.invalid>"

# Raspberry Pi ANPR camera settings.
CAMERA_BACKEND=picamera2
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
ANPR_EVENT_TYPE=entry